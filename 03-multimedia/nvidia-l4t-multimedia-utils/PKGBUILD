sha512sums=('517551713fe578ee23c4661a2737d6a8cccdff447f5cfd93dbc96b87ce11f9fdd446242d1d80250140c8574b0240b54dc3102816f06ff85b176c2f08b121ea4a')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

