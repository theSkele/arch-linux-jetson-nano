# Made by Scaredyfish
pkgname=nvidia-l4t-camera
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Camera Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('cairo' 'desktop-file-utils' 'expat' 'gcc' 'glib2' 'gtk3' 'hicolor-icon-theme' 'libegl' 'libglvnd' 'libx11' 'nvidia-l4t-core' 'nvidia-l4t-cuda' 'nvidia-l4t-multimedia-utils' 'nvidia-l4t-multimedia')
backup=('etc/systemd/system/nvargus-daemon.service')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-camera/nvidia-l4t-camera_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-camera_32.7.6-20241104234540_arm64.deb)
sha512sums=('8432cfed8f44affd060e1996e29d2fdf677717d5490d88885384e58d6295231603335260fff2dfdf1b5b9cc115459098b32d21f76a95dbad38cf04c300b62089')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-tegra/LICENSE.libnvcam_imageencoder" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-camera/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir usr/bin 2> /dev/null; mv usr/sbin/* usr/bin; rm -rf usr/sbin

	cd ..

}
