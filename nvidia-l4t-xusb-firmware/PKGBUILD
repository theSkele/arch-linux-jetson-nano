# Made by Scaredyfish
pkgname=nvidia-l4t-xusb-firmware
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA USB Firmware Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core<32.8' 'nvidia-l4t-core>32.7' 'nvidia-l4t-init<32.8' 'nvidia-l4t-init>32.7' 'nvidia-l4t-tools=32.7.3')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-xusb-firmware/nvidia-l4t-xusb-firmware_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-xusb-firmware_32.7.6-20241104234540_arm64.deb)
sha512sums=('c961374ac814b081e5e6c5936adc030e491d62224f1bd98f3ae92d5d55f80b1984d05960e809e48fc7f2e54362e081ac06c29329060b9a8e343a7f20c6ef89a3')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-l4t-xusb-firmware/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	mkdir -p usr/lib 2> /dev/null; mv lib/* usr/lib; rm -rf lib

	cd ..

}
