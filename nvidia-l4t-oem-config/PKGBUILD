# Made by Scaredyfish
pkgname=nvidia-l4t-oem-config
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA OEM-Config Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276jetson"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core')
backup=('etc/nv-oem-config.conf' 'etc/systemd/nv-oem-config-post.sh' 'etc/systemd/nv-oem-config.sh')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-oem-config/nvidia-l4t-oem-config_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-oem-config_32.7.6-20241104234540_arm64.deb)
sha512sums=('d92af0db45c54543e1ac63fd0496d52932e0cb837ae053403265cc09468aef2bef13c12a28282a7eb5005a5a65f0c2b835ae0312e4b5e97e71473b68e1c95c43')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/lib/ubiquity/plugins/nvlicense.py" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-oem-config/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir usr/bin 2> /dev/null; mv usr/sbin/* usr/bin; rm -rf usr/sbin
	mkdir -p usr/lib 2> /dev/null; mv lib/* usr/lib; rm -rf lib

	# Ubiquity is Ubuntu's installer, not needed for Arch
	rm -R usr/lib/ubiquity/plugins	

	cd ..
}
