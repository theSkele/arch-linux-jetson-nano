license=('custom:NVIDIA')
groups=('nvidia')
depends=('libdrm' 'libglvnd' 'libx11' 'libxkbcommon' 'mesa' 'nvidia-l4t-3d-core=32.7.6' 'nvidia-l4t-core<32.8' 'nvidia-l4t-core>32.7' 'nvidia-l4t-multimedia-utils=32.7.6' 'nvidia-l4t-weston=32.7.6' 'wayland')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-graphics-demos/nvidia-l4t-graphics-demos_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-graphics-demos_32.7.6-20241104234540_arm64.deb)
sha512sums=('89093625c7345ce255c56328f59d75bbff3cedecfb48062dbf64b1b490cbd98b90a50ac4a342d9e787edb6207b777ab7349558e48127cf8568d2cdcb65159b16')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/src/nvidia/graphics_demos/docs/LICENSE.nvidia" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-graphics-demos/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"

}
