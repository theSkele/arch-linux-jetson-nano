# Made by Scaredyfish
pkgname=nvidia-l4t-firmware
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Firmware Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('gcc' 'nvidia-l4t-core')
backup=('etc/systemd/nvwifibt-pre.sh' 'etc/systemd/nvwifibt.sh' 'etc/systemd/system/nvwifibt.service')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-firmware/nvidia-l4t-firmware_32.7.6-20241104234540_arm64.deb")
#source=("nvidia-l4t-firmware_32.7.6-20241104234540_arm64.deb")
sha512sums=('36f6610f5c072738bef9ce4461d791db2061531d6db80d3a99018e67cd36d3b8055a9b75fd66c3a5603226878cbcfa3e63d05d89f4e98585de3019ffe4bbd3e5')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-tegra/LICENSE.realtek_8822ce_wifibt.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-firmware/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir -p usr/bin 2> /dev/null; mv usr/sbin/* usr/bin; rm -rf usr/sbin
	mkdir -p usr/lib 2> /dev/null; mv lib/* usr/lib; rm -rf lib

	cd ..

}
