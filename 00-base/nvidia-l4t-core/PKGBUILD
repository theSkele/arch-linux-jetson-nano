# Made by Scaredyfish
pkgname=nvidia-l4t-core
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Core Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('expat' 'gcc' 'libglvnd')
replaces=('nvidia-l4t-ccp-t210ref')
backup=('etc/ld.so.conf.d/nvidia-tegra.conf' 'etc/nv_tegra_release')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-core/nvidia-l4t-core_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-core_32.7.6-20241104234540_arm64.deb)
sha512sums=('b3350016d326d5b75aa961901a16146e241643b40883d60feef1dfc649addaa521aaed27dc0b76eb14c2a2541741848fd4ce60289111d9e589e090234b452691')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-tegra/LICENSE.tegra_sensors" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-core/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir usr/bin 2> /dev/null; mv usr/sbin/* usr/bin; rm -rf usr/sbin

	cd ..

}
