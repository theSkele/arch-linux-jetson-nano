pkgname=nvidia-l4t-cuda
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA CUDA Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-3d-core' 'nvidia-l4t-core')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-cuda/nvidia-l4t-cuda_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-cuda_32.7.6-20241104234540_arm64.deb)
sha512sums=('c8f6942b210e9acb4d45a7707421ee6166bab3e46b032c294df4698ac17d813e163031a4c9fd9634dd862d8d977900076f6efb50f85c730ee859a6b4bce9b367')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-cuda/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
