pkgname=nvidia-l4t-3d-core
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA GL EGL Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('gcc' 'libglvnd' 'libx11' 'libxext' 'nvidia-l4t-core' 'nvidia-l4t-firmware' 'nvidia-l4t-init' 'nvidia-l4t-libvulkan' 'wayland')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-3d-core/nvidia-l4t-3d-core_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-3d-core_32.7.6-20241104234540_arm64.deb)
sha512sums=('d2fea012f1e891d0767fc3699a957c188aeda4e56286a91c2c1edce3e6a31384ce5a3bb5334acec8fdec738463fa4b11ae1e349561031cf6c221dde5de747dcb')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-3d-core/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}

