pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Wayland Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('libffi' 'nvidia-l4t-core' 'nvidia-l4t-core' 'wayland')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-wayland/nvidia-l4t-wayland_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-wayland_32.7.6-20241104234540_arm64.deb)
sha512sums=('4e429a36d37f2fdd819712235b9709eaf71ccd286561c2fa872f0807af10a4124fb275296d662f07ca0455a7d775065af91035d5de65ac3f91d80e29018deaf8')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-wayland/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
