pkgname=nvidia-l4t-libvulkan
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Vulkan Loader Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core<32.8' 'nvidia-l4t-core>32.7')
replaces=('nvidia-l4t-3d-core<=32.5.1')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-libvulkan/nvidia-l4t-libvulkan_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-libvulkan_32.7.6-20241104234540_arm64.deb)
sha512sums=('e3fc10b25c31ed56f493da9256400c92a52fbd5181db1bb62c6a4aa1f09bb5d1eb7a6dd6cc3fcab16f5e20290ddc8c4a975e46e5128daa2b56dc9f96e9d812ca')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-tegra/LICENSE.libvulkan1.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-libvulkan/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"

}
