pkgname=nvidia-l4t-x11
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA X11 Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core' 'nvidia-l4t-firmware' 'nvidia-l4t-init' 'nvidia-l4t-3d-core')
backup=('etc/X11/xorg.conf' 'etc/X11/xorg.conf.jetson_e')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-x11/nvidia-l4t-x11_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-x11_32.7.6-20241104234540_arm64.deb)
sha512sums=('865db1d50efb5df45cf944a2e68670cb12de03554e737bb234553dc660f9698c5ff62b3f9651ec6bf0c149e68884731f37c70dedb3c55f98c4fee9d373295ad4')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-x11/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
