pkgname=nvidia-l4t-bootloader
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Bootloader Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core<32.8' 'nvidia-l4t-core>32.7' 'nvidia-l4t-init<32.8' 'nvidia-l4t-init>32.7' 'nvidia-l4t-tools=32.7.6')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-bootloader/nvidia-l4t-bootloader_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-bootloader/nvidia-l4t-bootloader_32.7.6-20241104234540_arm64.deb)
sha512sums=('6b3fec04b46d684b9c071b3a787ff0d7a723c65c0ce2e942bfb08c26f79ec1f929964b1a5e8d2ff1cd6858f749d45a9dc1ead940b7bc8b43baaf415c7b2aeae6')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-bootloader/LICENSE.bl_update_payload.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-bootloader/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"

}
