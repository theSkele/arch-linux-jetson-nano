package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/udev/copyright.compliant.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"


	# remove debian specific stuff
	rm -R ${pkgdir}/etc/systemd/system/apt-daily-upgrade.timer.d
	rm -R ${pkgdir}/etc/systemd/system/apt-daily.timer.d
}
