pkgrel=1
pkgdesc="NVIDIA JetsonIO debian package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('dtc' 'nvidia-l4t-core>32.7' 'python')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-jetson-io/nvidia-l4t-jetson-io_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-jetson-io_32.7.6-20241104234540_arm64.deb)
sha512sums=('5da0bcca5486e913e7527fd95216bc84e9cef573420187f643d75b3a9c30dcdaf02975fa0871d67b0e7fa38a2eed4f185827efef95f5db3e917525536c9c75d9')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-jetson-io/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
