# Made by Scaredyfish
pkgname=nvidia-l4t-gputools
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA dgpu helper Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core<32.8' 'python')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-gputools/nvidia-l4t-gputools_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-gputools_32.7.6-20241104234540_arm64.deb)
sha512sums=('b52e18dc3c968ffb80c4b31d402071bb8d10dc4f145b5b2e80c0fc3f128c0c85e7826b248b0523105881f4ed26d01c92eda943efa4ae7d2161a71eceb00a7be9')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-gputools/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
