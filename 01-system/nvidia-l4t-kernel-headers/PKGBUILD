# Made by Scaredyfish
pkgname=nvidia-l4t-kernel-headers
pkgver=4.9.337_tegra
pkgrel=1
pkgdesc="NVIDIA Linux Tegra Kernel Headers Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core' 'nvidia-l4t-kernel=4.9.337_tegra')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-kernel-headers/nvidia-l4t-kernel-headers_4.9.337-tegra-32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-kernel-headers_4.9.337-tegra-32.7.6-20241104234540_arm64.deb)
sha512sums=('528497bcd891ac0e0c9acf5eea91c7c4bdbc02b792a722b003ea3c441553c1e192f18b19645c368b10f0fd236530bda8f86c8c6419d9653c672e85aa29ac2ef1')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/src/linux-headers-4.9.337-tegra-ubuntu18.04_aarch64/kernel-4.9/include/linux/license.h" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-kernel-headers/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir -p usr/lib 2> /dev/null; mv lib/* usr/lib; rm -rf lib

	cd ..

}
