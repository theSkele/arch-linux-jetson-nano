pkgname=nvidia-l4t-tools
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Public Test Tools Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core<32.8' 'nvidia-l4t-core>32.7')
backup=('etc/nvpmodel/nvpmodel_t210.conf' 'etc/nvpmodel/nvpmodel_t210_jetson-nano.conf' 'etc/xdg/autostart/nvpmodel_indicator.desktop')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-tools/nvidia-l4t-tools_32.7.6-20241104234540_arm64.deb")
#source=("nvidia-l4t-tools_32.7.6-20241104234540_arm64.deb")
sha512sums=('6a866e06a501967ed99b265ff875d9d98607d894fce9dc1ea6a13f8c55d0e3d0b4c649f26e621836063bacad8d5d52a1eac86833994cf2269948b8d1953838dd')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-tegra/NVIDIA_Trademark_License_Addendum_SW.pdf.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-tools/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir -p usr/bin 2> /dev/null; mv usr/sbin/* usr/bin; rm -rf usr/sbin

	cd ..

}
