pkgname=nvidia-l4t-multimedia
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA Multimedia Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('alsa-lib' 'cairo' 'expat' 'fontconfig' 'gcc' 'glib2' 'gst-plugins-bad-libs' 'gst-plugins-base-libs' 'gstreamer' 'harfbuzz' 'libdatrie' 'libglvnd' 'libx11' 'libxau' 'libxcb' 'libxdmcp' 'libxext' 'libxrender' 'nvidia-l4t-core' 'nvidia-l4t-cuda' 'pcre' 'pixman' 'zlib')
options=('!strip' '!emptydirs')
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-multimedia/nvidia-l4t-multimedia_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-multimedia_32.7.6-20241104234540_arm64.deb)
sha512sums=('76f4dc4d872c30731f58e0712f9c85d03dac498f4f76b3244718c3b2198fbb44dbed4be75725cc245acb1d9a2337fed53e67cabf58cf1f2cdccbe96408a0aa0c')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-tegra/LICENSE.libnvv4lconvert.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-multimedia/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"

}
