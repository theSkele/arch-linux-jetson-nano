# Made by Scaredyfish
pkgname=nvidia-l4t-kernel
pkgver=4.9.337_tegra
pkgrel=1
pkgdesc="NVIDIA Kernel Package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('GPL' 'custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core' 'nvidia-l4t-init' 'nvidia-l4t-tools' 'xxd')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-kernel/nvidia-l4t-kernel_4.9.337-tegra-32.7.6-20241104234540_arm64.deb")
sha512sums=('f6f18e611c93b526d336e50ebdf368ff68a4616c5c1ae855e342a59d5ba70286eb3f4433ad4c1a91f8d26d1c601505e4db3837ebf495b768cca96c89a4ba677f')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	# Fix directory structure differences
	cd "${pkgdir}"

	install -D -m644 "usr/share/doc/nvidia-l4t-kernel/LICENSE.kernel.gz" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -D -m644 "usr/share/doc/nvidia-l4t-kernel/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
	mkdir -p usr/lib 2> /dev/null; mv lib/* usr/lib; rm -rf lib

	cd ..

}
