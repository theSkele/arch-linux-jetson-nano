pkgname=nvidia-l4t-initrd
pkgver=32.7.6
pkgrel=1
pkgdesc="NVIDIA initrd debian package."
arch=('aarch64')
url="https://developer.nvidia.com/embedded/linux-tegra-r3276"
license=('custom:NVIDIA')
groups=('nvidia')
depends=('nvidia-l4t-core' 'nvidia-l4t-xusb-firmware')
options=('!strip' '!emptydirs')
install=${pkgname}.install
source=("https://repo.download.nvidia.com/jetson/t210/pool/main/n/nvidia-l4t-initrd/nvidia-l4t-initrd_32.7.6-20241104234540_arm64.deb")
#source=(nvidia-l4t-initrd_32.7.6-20241104234540_arm64.deb)
sha512sums=('619cbeab480baa165b2ee212e3fdc363f7b3222106d70ca474672b1e833f27fb8cdb270bad8f27b527368ca4a755271b8fceaee66f586f8b8abaec6dcca939fa')

package(){

	# Extract package data
	tar -xI unzstd -f data.tar.zst -C "${pkgdir}"

	install -D -m644 "${pkgdir}/usr/share/doc/nvidia-l4t-initrd/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

}
